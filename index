<script>const quizData=[             {                 q: "1. Which gas makes up approximately 78% of Earth's atmosphere?",                 options: ["Oxygen", "Argon", "Carbon dioxide", "Nitrogen"],                 answer: 3             },             {                 q: "2. Which group of gases functions as greenhouse gases by trapping heat in Earth's atmosphere?",                 options: ["Nitrogen, Oxygen, and Argon", "Carbon dioxide, Methane, and Water vapor", "Oxygen, Helium, and Ozone", "Argon, Nitrogen, and Hydrogen"],                 answer: 1             },             {                 q: "3. In which atmospheric layer do shooting stars (meteors) burn up, and which layer contains the protective ozone layer?",                 options: ["Thermosphere and Exosphere", "Mesosphere and Stratosphere", "Troposphere and Mesosphere", "Stratosphere and Troposphere"],                 answer: 1             },             {                 q: "4. What process occurs when a rising air mass expands due to decreasing atmospheric pressure, causing its temperature to drop?",                 options: ["Advective cooling", "Latent heating", "Adiabatic cooling", "Radiative heating"],                 answer: 2             },             {                 q: "5. Which lower-atmospheric weather instrument is specifically used to measure wind speed?",                 options: ["Barometer", "Anemometer", "Radiosonde", "Thermometer"],                 answer: 1             },             {                 q: "6. Which low-altitude, fluffy clouds resemble cotton balls and can grow vertically into storm-producing cumulonimbus clouds on hot, humid days?",                 options: ["Cirrus", "Stratus", "Cumulus", "Altostratus"],                 answer: 2             },             {                 q: "7. An air mass that forms over land in polar regions (continental polar / cP) has which temperature and humidity characteristics?",                 options: ["Warm and moist", "Warm and dry", "Cold and moist", "Cold and dry"],                 answer: 3             },             {                 q: "8. Which severe weather phenomenon features a narrow, violently rotating column of air spawned by a supercell thunderstorm?",                 options: ["Hurricane", "Tornado", "Midlatitude cyclone", "Blizzard"],                 answer: 1             },             {                 q: "9. What happens when relative humidity reaches 100% and the air temperature drops to its dew point?",                 options: ["Atmospheric pressure instantly drops to zero", "Net condensation occurs, forming fog, dew, or clouds", "The air mass stops expanding and begins to burn", "Oxygen molecules split apart into ions"],                 answer: 1             },             {                 q: "10. What instrument package is carried into the upper atmosphere by a weather balloon to measure relative humidity, air pressure, and temperature?",                 options: ["Doppler radar", "Station model", "Radiosonde", "Wind vane"],                 answer: 2             },             {                 q: "11. Regarding physical mass and matter, Earth functions primarily as which type of planetary system?",                 options: ["Open system", "Closed system", "Isolated system", "Radiative system"],                 answer: 1             },             {                 q: "12. Which cooling process occurs when warm, moist air moves horizontally over a cold land or ocean surface, causing fog to form?",                 options: ["Convective lifting", "Latent heating", "Advective cooling", "Adiabatic expansion"],                 answer: 2             },             {                 q: "13. Why does atmospheric pressure decrease as elevation increases above Earth's surface?",                 options: ["Air temperature increases rapidly at higher altitudes", "The force of gravity becomes stronger higher up", "There are fewer air molecules overhead, reducing the weight pressing down", "The ozone layer absorbs all atmospheric pressure"],                 answer: 2             },             {                 q: "14. Why would an astronaut in the thermosphere freeze, even though individual gas particles there reach temperatures over 1,000°C?",                 options: ["Solar radiation destroys all heat in space", "Air molecules are so sparse that very few collide with a body to transfer heat energy", "The thermosphere is made entirely of solid ice particles", "The ozone layer reflects all thermal energy back to Earth"],                 answer: 1             },             {                 q: "15. Which specialized weather instrument is used by meteorologists to measure relative humidity and atmospheric moisture?",                 options: ["Barometer", "Hygrometer", "Anemometer", "Wind vane"],                 answer: 1             },             {                 q: "16. What scale do meteorologists use to categorize the intensity and wind speeds of hurricanes (tropical cyclones)?",                 options: ["Fujita scale", "Richter scale", "Saffir-Simpson scale", "Beaufort scale"],                 answer: 2             },             {                 q: "17. What is the fundamental cause of horizontal air movement (wind) across Earth's surface?",                 options: ["Uneven solar heating that creates air pressure differences", "Gravitational pull from the moon on atmospheric gases", "Volcanic emissions releasing dense gas into the troposphere", "Ocean tides pushing surface air inland"],                 answer: 0             },             {                 q: "18. Which high-altitude clouds are thin, feathery, and composed primarily of ice crystals?",                 options: ["Stratus", "Cumulus", "Cirrus", "Nimbostratus"],                 answer: 2             },             {                 q: "19. Tropical cyclones (hurricanes) draw their energy and power primarily from which environmental source?",                 options: ["Sinking polar air masses", "Warm ocean waters and moist, rising air", "Friction with high-altitude jet streams", "Dry air moving off continental landmasses"],                 answer: 1             },             {                 q: "20. Which layer of Earth's atmosphere contains the highest concentration of protective ozone, absorbing harmful solar ultraviolet (UV) radiation?",                 options: ["Troposphere", "Stratosphere", "Mesosphere", "Thermosphere"],                 answer: 1             }         ];
const storageKey='latterup-atmosphere-mastery-v1';const $=id=>document.getElementById(id);let checks=0;let completed=false;
function getAnswers(){return quizData.map((_,i)=>{const input=document.querySelector('input[name="q'+i+'"]:checked');return input?Number(input.value):null})}
function save(){try{localStorage.setItem(storageKey,JSON.stringify({name:$('studentName').value,answers:getAnswers(),checks,completed}))}catch{}}
function render(){quizData.forEach((q,i)=>{const card=document.createElement('section');card.className='question';card.id='question-'+i;const title=document.createElement('h3');title.textContent=q.q;card.appendChild(title);q.options.forEach((answer,j)=>{const lbl=document.createElement('label');lbl.className='option';const input=document.createElement('input');input.type='radio';input.name='q'+i;input.value=j;input.addEventListener('change',()=>{card.classList.remove('right','wrong');card.querySelector('.feedback').textContent='';updateProgress();save()});lbl.append(input,document.createTextNode(answer));card.appendChild(lbl)});const feedback=document.createElement('p');feedback.className='feedback';card.append(feedback);$('questionsContainer').append(card)});updateProgress()}
function updateProgress(){$('progress').textContent=getAnswers().filter(v=>v!==null).length+' of '+quizData.length+' answered'}
function buildReport(){const name=$('studentName').value.trim();$('studentInfo').textContent='Student: '+name+'  |  Completed: '+new Date().toLocaleString()+'  |  Checks: '+checks;$('answerReport').replaceChildren();quizData.forEach((q,i)=>{const section=document.createElement('section');section.className='answer-record';const heading=document.createElement('h3');heading.textContent=q.q;const p=document.createElement('p');p.textContent='My answer: '+q.options[q.answer];section.append(heading,p);$('answerReport').append(section)})}
function finish(){completed=true;save();buildReport();$('quizArea').classList.add('hidden');$('report').classList.remove('hidden');window.scrollTo({top:0,behavior:'smooth'})}
$('quizForm').addEventListener('submit',e=>{e.preventDefault();const name=$('studentName').value.trim();if(!name){$('status').textContent='Enter your full name before checking answers.';$('status').className='error';$('studentName').focus();return}const answers=getAnswers(),missing=answers.indexOf(null);if(missing!==-1){$('status').textContent='Please answer all 20 questions first.';$('status').className='error';$('question-'+missing).scrollIntoView({behavior:'smooth',block:'center'});return}checks++;let score=0;quizData.forEach((q,i)=>{const card=$('question-'+i),good=answers[i]===q.answer;if(good)score++;card.classList.toggle('right',good);card.classList.toggle('wrong',!good);card.querySelector('.feedback').textContent=good?'✓ Correct':'✕ Try again. Review this concept in NotebookLM, then choose another answer.'});save();if(score===quizData.length){finish();return}$('status').className='';$('status').textContent='You scored '+score+' / '+quizData.length+' ('+Math.round(score/quizData.length*100)+'%). '+(quizData.length-score)+' question(s) still need attention. Review the red questions and check again. Your quiz is not ready to turn in.'; $('status').scrollIntoView({behavior:'smooth',block:'start'})});
$('studentName').addEventListener('input',save);$('printBtn').addEventListener('click',()=>window.print());$('restartBtn').addEventListener('click',()=>{if(!confirm('Clear this browser’s saved work and start again?'))return;localStorage.removeItem(storageKey);location.reload()});render();try{const prior=JSON.parse(localStorage.getItem(storageKey)||'null');if(prior){$('studentName').value=prior.name||'';checks=prior.checks||0;(prior.answers||[]).forEach((answer,i)=>{if(answer!==null&&Number.isInteger(answer)){const input=document.querySelector('input[name="q'+i+'"][value="'+answer+'"]');if(input)input.checked=true}});updateProgress();if(prior.completed&&quizData.every((q,i)=>prior.answers?.[i]===q.answer)){finish()}else if(checks){$('status').textContent='Your earlier work was restored. Continue practicing until you earn 100%.'}}}catch{}
</script></body></html>
